<Window x:Class="Printer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:local="clr-namespace:Printer"
        mc:Ignorable="d"
        Closing="WindowClosing" 
        ResizeMode="CanMinimize"
        Title="Printer" Height="700" Width="1000" Background="#FF3E6FB3" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <TabControl x:Name="Log" HorizontalAlignment="Left" Height="172" Margin="5,485,0,0" VerticalAlignment="Top" Width="790" Background="#FFE6F0FF">
            <TabControl.Resources>
                <Style TargetType="RichTextBox">
                    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="IsReadOnly" Value="True" />
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </Style>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="FontSize" Value="16" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="一般" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxGeneral" Background="#FF43B5BF"/>
            </TabItem>
            <TabItem Header="警告" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxWarning" Background="#FF43AABF"/>
            </TabItem>
            <TabItem Header="錯誤" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxError" Background="#FF43A0BF"/>
            </TabItem>
            <TabItem Header="除錯" Style="{StaticResource BaseTabcontrol}">
                <RichTextBox x:Name="richTextBoxDebug" Background="#FF4396BF"/>
            </TabItem>
        </TabControl>
        <Image x:Name="Logo" HorizontalAlignment="Left" Height="153" Margin="813,507,0,0" VerticalAlignment="Top" Width="156" Source="/Icon/Printer.png"/>
        <TabControl HorizontalAlignment="Left" Margin="5,3,0,0" VerticalAlignment="Top" Height="478" Width="978" Background="#FFE6F0FF">
            <TabItem Header="主畫面" Style="{StaticResource BaseTabcontrol}">
                <Grid>
                    <WrapPanel Orientation="Horizontal" Margin="76,38,79,250">
                        <Button x:Name="Open_MergePdf_Folder" Style="{StaticResource BaseButton}" Margin="50,0,0,0" FontSize="18"  Background="#FFE6F0FF" BorderThickness="0" Click="Main_Btn_Click">
                            <Button.ToolTip>
                                <ToolTip Background="Transparent" Padding="0" BorderThickness="0" HasDropShadow="True">
                                    <Border Background="Gray" CornerRadius="10" Padding="8">
                                        <TextBlock FontSize="14" Foreground="#00FF66">開啟合併PDF資料夾路徑</TextBlock>
                                    </Border>
                                </ToolTip>
                            </Button.ToolTip>
                            <Image x:Name="Open_MergePdf_Folder_Icon" Source="UI/Open Folder Path.png" Width="82" Height="76"/>
                        </Button>
                        <TextBox x:Name="MergePdf_Folder_Path" Style="{StaticResource BaseTextBox}" Tag="請輸入合併PDF檔資料夾路徑!" Margin="30,15,0,0" FontSize="12" Height="42" Width="590"/>
                        <Button x:Name="Open_SplitPdf_Folder" Style="{StaticResource BaseButton}" Margin="50,0,0,0" FontSize="18"  Background="#FFE6F0FF" BorderThickness="0" Click="Main_Btn_Click">
                            <Button.ToolTip>
                                <ToolTip Background="Transparent" Padding="0" BorderThickness="0" HasDropShadow="True">
                                    <Border Background="Gray" CornerRadius="10" Padding="8">
                                        <TextBlock FontSize="14" Foreground="#00FF66">開啟切割PDF資料夾路徑</TextBlock>
                                    </Border>
                                </ToolTip>
                            </Button.ToolTip>
                            <Image x:Name="Open_SplitPdf_Folder_Icon" Source="UI/Open Folder Path.png" Width="82" Height="76"/>
                        </Button>
                        <TextBox x:Name="SplitPdf_Folder_Path" Style="{StaticResource BaseTextBox}" Tag="請輸入切割PDF檔資料夾路徑!" Margin="30,15,0,0" FontSize="12" Height="42" Width="590"></TextBox>
                    </WrapPanel>
                    <Button x:Name="Show_Printer" Style="{StaticResource CircleButton}" Margin="8,42,845,285" Content="顯示印表機" FontSize="18" Click="Main_Btn_Click"/>
                    <Button x:Name="Print" Style="{StaticResource CircleButton}" Margin="20,174,833,151" Content="列印" FontSize="18" Click="Main_Btn_Click"/>
                    <Button x:Name="PrintPreview" Style="{StaticResource CircleButton}" Margin="20,300,833,28" Content="預覽" FontSize="18" Click="Main_Btn_Click"/>
                    <Button x:Name="Merge_PDF" Style="{StaticResource CircleButton}" Margin="158,244,695,84" Content="合併PDF" FontSize="18" Click="Main_Btn_Click">
                        <Button.ToolTip>
                            <ToolTip Background="Transparent" Padding="0" BorderThickness="0" HasDropShadow="True">
                                <Border Background="Gray" CornerRadius="10" Padding="8">
                                    <TextBlock FontSize="14" Foreground="#00FF66">將檔名命名數字從1開始，此按鈕才有效!</TextBlock>
                                </Border>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button x:Name="Split_PDF" Style="{StaticResource CircleButton}" Margin="428,246,425,82" Content="分割PDF" FontSize="18" Click="Main_Btn_Click"/>
                    <Button x:Name="Save_Config" Style="{StaticResource CircleButton}" Margin="697,250,156,78" Content="儲存參數" FontSize="18" Click="Main_Btn_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
